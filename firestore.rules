rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       🔹 HELPER FUNCTIONS
    ========================== */

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userCompanyId() {
      return userData().companyId;
    }

    function userRole() {
      return userData().role;
    }

    function isSuperAdmin() {
      return userExists() && userRole() == "super_admin";
    }

    function isAdmin() {
      return userExists() && (userRole() == "admin" || userRole() == "super_admin");
    }

    function isManager() {
      return userExists() && (userRole() == "manager" || userRole() == "admin" || userRole() == "super_admin");
    }

    function belongsToSameCompany(companyId) {
      return isAuthenticated() &&
             userExists() &&
             companyId == userCompanyId();
    }

    /* =========================
       🏢 COMPANIES
    ========================== */

    match /companies/{companyId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        belongsToSameCompany(companyId)
      ));

      allow create: if isAuthenticated();

      allow update, delete: if isSuperAdmin() || (isAuthenticated() &&
                            (isAdmin() || (resource != null && resource.data.ownerId == request.auth.uid)) &&
                            belongsToSameCompany(companyId));
    }

    /* =========================
       👤 USERS
    ========================== */

    match /users/{userId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && belongsToSameCompany(resource.data.companyId))
      ));

      allow create: if isAuthenticated();

      allow update: if isSuperAdmin() || (isAuthenticated() && (
        (request.auth.uid == userId) || 
        (isManager() && belongsToSameCompany(resource.data.companyId))
      ));

      allow delete: if isSuperAdmin();
    }

    /* =========================
       📩 INVITES
    ========================== */

    match /invites/{inviteId} {
      allow create: if isAuthenticated() && isManager();

      allow read: if isSuperAdmin() || 
                  (resource.data.email == request.auth.token.email) || 
                  (isAuthenticated() && belongsToSameCompany(resource.data.companyId));

      allow get: if resource.data.status == "pending";
      allow list: if isSuperAdmin() || (request.query.limit == 1 && request.query.token != null);

      allow update: if isSuperAdmin() || (resource.data.status == "pending" &&
                    request.resource.data.status == "accepted" &&
                    resource.data.email == request.auth.token.email);

      allow delete: if isSuperAdmin() || (isAuthenticated() && isManager() && belongsToSameCompany(resource.data.companyId));
    }

    /* =========================
       📁 PROJECTS / TASKS / LOGS
    ========================== */

    match /{collection}/{id} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource != null && belongsToSameCompany(resource.data.companyId));
      allow write: if isSuperAdmin() || (isAuthenticated() && belongsToSameCompany(request.resource.data.companyId) && isManager());
    }
  }
}